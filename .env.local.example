# ── Supabase ──────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ── Google Drive (optional) ───────────────────────────────────
# Enables reading files from shared Google Drive folders without OAuth.
# Get from: console.cloud.google.com → APIs & Services → Credentials → Create API Key
# Restrict key to: Google Drive API only.
# Users paste their own shared Drive folder URL — no developer account needed.
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=AIza...
